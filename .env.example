# Copy to .env.local and fill in real values. Never commit .env files.

# Application
APP_URL=http://localhost:3000
# User content is served from this host (ADR-0007). Locally it is the same host.
SHARE_DOMAIN=localhost:3000

# Supabase Postgres connection string (use the pooled connection for the app).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/memorynotes

# Auth.js. Generate a secret with: npx auth secret
AUTH_SECRET=replace-me

# Google OAuth (Auth.js reads the AUTH_ prefix automatically).
AUTH_GOOGLE_ID=replace-me
AUTH_GOOGLE_SECRET=replace-me

# GitHub OAuth.
AUTH_GITHUB_ID=replace-me
AUTH_GITHUB_SECRET=replace-me

# Optional. Shared secret for the scheduled purge endpoint
# (POST /api/v1/jobs/purge). The endpoint is disabled when this is unset.
CRON_SECRET=replace-me

# Comma-separated emails allowed into the moderation triage queue
# (/admin/reports and GET /api/v1/reports).
ADMIN_EMAILS=you@example.com

# Moderation. The built-in provider is "local": exact hash matching against a
# known-materials list (the CSAM gate) plus blocked terms. A vendor adapter
# implements the same interface without changing the write paths.
MODERATION_PROVIDER=local
# Comma-separated sha256 hashes of known-materials content.
MODERATION_BLOCKED_HASHES=
# Comma-separated substrings that always block (refused categories, A12).
MODERATION_BLOCKED_TERMS=
# Salt mixed into moderation hashes. Falls back to AUTH_SECRET when unset.
MODERATION_HASH_SALT=
